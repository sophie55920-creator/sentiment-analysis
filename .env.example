# ==============================================================================
# Weekends Sentiment Lab - 환경 변수 템플릿 (.env.example)
# ==============================================================================
# 이 파일은 공유 가능한 환경 변수 예시 파일입니다.
# 실제 비밀키는 .env 파일에만 입력하고, 이 파일에는 플레이스홀더만 유지합니다.
# ==============================================================================

# OpenAI API Key (gpt-4o-mini 호출용)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Project URL (PostgreSQL 연동용)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (서버사이드 전용 관리자 키)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

